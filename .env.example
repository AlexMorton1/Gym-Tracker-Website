# Copy this file to .env for local testing against a real Turso database
# (optional — without these set, the app uses a local SQLite file instead).
# On Render, set these as Environment Variables in the dashboard instead
# of using a .env file.

TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
